{
  "name": "gradation-bridge",
  "version": "0.4.5",
  "description": "ACP bridge daemon for GradatiON Code mode \u2014 launches local coding agents and relays sessions to the phone over authenticated WebSocket.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "gradation-bridge": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --import tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "fake-agent": "tsx src/harness/fake-agent.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "gradation",
    "bridge",
    "coding-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.5.0",
    "ws": "^8.18.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
